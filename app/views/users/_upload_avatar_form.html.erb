<%= form_tag(avatar_user_path(user), method: :patch,
                                     multipart: true,
                                     data: {
                                        controller: 'upload-avatar',
                                        upload_avatar_target: 'form'
                                     }) do %> 
  <button type="button"
          class="btn btn-outline upload-avatar-button"
          aria-label="Upload an Avatar"
          data-action="click->upload-avatar#fileUploadTrigger">
    <i class="bi bi-pencil-square text-white" title="Change avatar"></i>
  </button>
  <div class="d-none">
    <%= file_field_tag :image, 
                    value: :image,
                    id: 'avatarInput',
                    class: 'd-none',
                    data: {
                      action: "change->upload-avatar#fileChanged",
                      upload_avatar_target: 'fileInput'
                    },
                    required: true 
    %>
  </div>
<% end %>