<div id="<%= dom_id(post, :like) %>">
  <% liked = post.likes.exists?(user_id: user.id) %>
  <% icon_class_list = liked ? "bi bi-heart-fill liked" : "bi bi-heart" %>
  <% button_title = liked ? "Unlike this Post." : "Like this Post." %>

  
  <button data-controller="like"
          data-turbo="true"
          data-liked="<%= liked %>" 
          data-post-uuid="<%= post.uuid %>" 
          data-action="click->like#like" 
          class="engagement-button-background <%= liked ? "liked" : "unliked" %>"
          title="<%= button_title %>">
    <i class="<%= icon_class_list %>" alt="Like this Post"></i><span><%= post.likers.count %></span>
  </button>
</div>