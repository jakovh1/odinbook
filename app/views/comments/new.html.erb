<%= turbo_frame_tag "comment-modal" do %>
  <div class="comment-modal-container" data-controller="modal-comment">
    <div class="modal-content bg-dark">
      <button type="button" class="btn-close btn-close-white" data-modal-comment-target="modalClose" data-action="modal-comment#buttonClose" aria-label="Close"></button>

      <%= render "form", comment: @comment, modal: true %>
    </div>
  </div>
<% end %>

